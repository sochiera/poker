# Copy to .env and adjust. Never commit the real .env.
#   cp .env.example .env && ${EDITOR:-nano} .env

# --- public address -------------------------------------------------------
# Domain served by Caddy. Its A/AAAA record must already point at this VPS,
# because a certificate is requested on first start.
# Use "http://localhost" to try the stack locally without any certificate.
APP_DOMAIN=poker.example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# --- secrets --------------------------------------------------------------
# Redis is only reachable on the internal compose network, but it still gets a
# password. Generate one, do not reuse this placeholder:
#   openssl rand -base64 32
REDIS_PASSWORD=replace-me-with-a-generated-secret

# --- sizing and lifetimes -------------------------------------------------
# App worker processes per container. They share state through Redis, so this
# can be raised freely; `docker compose up -d --scale app=3` also works.
APP_WORKERS=2

# Absolute lifetime of a room and its history from creation (30 days).
# Actions and reconnects do not renew this deadline.
ROOM_TTL_SECONDS=2592000

# How long a disconnected participant can come back with the same identity.
SESSION_TTL_SECONDS=900

# Presence lease per browser tab and how often it is renewed. The lease must be
# at least twice the heartbeat, so one missed beat does not drop anyone.
CONNECTION_LEASE_SECONDS=45
HEARTBEAT_SECONDS=15

# Upper bound on people in a single room.
MAX_PARTICIPANTS=50

# Memory ceiling for Redis. Redis uses noeviction: monitor write failures when full.
REDIS_MAXMEMORY=256mb

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
